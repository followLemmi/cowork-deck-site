---
/* The footer. Three columns that become two on a tablet and one-plus-two on a
   phone, where the link rows also grow to a 44px touch target — a 34px row is
   fine under a cursor and a coin-flip under a thumb. */
import { SITE } from '../data/site'
const year = new Date().getFullYear()
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__inner">
      <div class="ftr__about">
        <p class="ftr__brand">cowork-deck</p>
        <p class="ftr__note">
          {SITE.tagline}. Free and open source under the {SITE.license} licence.
        </p>
      </div>

      <nav aria-label="Product">
        <h2>Product</h2>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/install/">Install</a></li>
          <li><a href="/changelog/">Changelog</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </nav>

      <nav aria-label="Project">
        <h2>Project</h2>
        <ul>
          <li><a href={SITE.repo} rel="noopener">Source on GitHub</a></li>
          <li><a href={SITE.issues} rel="noopener">Issues and roadmap</a></li>
          <li><a href="/design/">The True Ink design system</a></li>
          <li><a href="/rss.xml">Release feed (RSS)</a></li>
        </ul>
      </nav>
    </div>

    <div class="ftr__legal">
      <p>© {year} {SITE.author.name}. Not affiliated with Anthropic.</p>
    </div>
  </div>
</footer>
