---
/* The header, and the site's whole navigation.
 *
 * On a phone the nav is a `<details>` disclosure rather than a horizontally
 * scrolling strip. The strip was cheaper, but it hid two of the five items
 * behind a scrollbar that was itself hidden — a nav item nobody can see is a
 * nav item that does not exist.
 *
 * The disclosure needs no JavaScript at all: every link in it is a real page
 * navigation, so the drawer closes by virtue of the next page loading. That is
 * why this component ships none. */
import { NAV, SITE } from '../data/site'
const path = Astro.url.pathname
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined)
---

<header class="hdr">
  <div class="wrap hdr__inner">
    <a class="brand" href="/">
      <img src="/icon-32.png" width="24" height="24" alt="" />
      <span>cowork-deck</span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
      ))}
      <a class="hdr__gh" href={SITE.repo} rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-1.94c-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.3 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.18-1.48 3.14-1.18 3.14-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.8.55A11.5 11.5 0 0 0 23.5 12A11.5 11.5 0 0 0 12 .5Z"
          /></svg
        >
        GitHub
      </a>
    </nav>

    <details class="mnav">
      <summary aria-label="Menu">
        <svg class="mnav__open" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.5" stroke-linecap="round" aria-hidden="true"
          ><path d="M4 7h16M4 12h16M4 17h16" /></svg
        >
        <svg class="mnav__close" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.5" stroke-linecap="round" aria-hidden="true"
          ><path d="M6 6l12 12M18 6 6 18" /></svg
        >
      </summary>
      <div class="mnav__panel">
        {NAV.map((item) => (
          <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
        ))}
        <a href={SITE.repo} rel="noopener">Source on GitHub</a>
      </div>
    </details>
  </div>
</header>
