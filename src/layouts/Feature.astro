---
/* The frame every feature page shares: head, breadcrumb, title block, the
 * screenshot, and the cross-links at the foot. The page itself supplies only
 * its prose, which is the part that has to be unique — two pages with the same
 * body are one page as far as a search engine is concerned. */
import Base from './Base.astro'
import { featureBySlug, FEATURES } from '../data/features'
import { breadcrumbs, techArticle } from '../data/schema'

interface Props { slug: string }
const { slug } = Astro.props
const f = featureBySlug(slug)
const others = FEATURES.filter((x) => x.slug !== slug).slice(0, 3)
---

<Base
  title={f.pageTitle}
  description={f.description}
  image={f.og}
  imageAlt={f.imageAlt}
  schema={[
    techArticle({
      headline: f.pageTitle,
      description: f.description,
      path: `/features/${f.slug}/`,
      image: f.og,
    }),
    breadcrumbs([
      { name: 'cowork-deck', path: '/' },
      { name: 'Features', path: '/features/' },
      { name: f.title, path: `/features/${f.slug}/` },
    ]),
  ]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">cowork-deck</a></li>
        <li><a href="/features/">Features</a></li>
        <li aria-current="page">{f.title}</li>
      </ol>
    </nav>

    <article>
      <div class="phead phead--crumbed">
        <h1 class="h1--page">{f.pageTitle}</h1>
        <p class="lede">{f.summary}</p>
      </div>

      <figure class="shot bleed" style="margin-top: 0">
        <img
          src={f.image}
          alt={f.imageAlt}
          width={f.width}
          height={f.height}
          fetchpriority="high"
        />
      </figure>

      <div class="prose" style="margin-top: clamp(2.5rem, 5vw, 3.5rem)">
        <slot />
      </div>

      <aside class="more">
        <h2>Also in cowork-deck</h2>
        <div class="flist">
          {others.map((o) => (
            <a class="fitem" href={`/features/${o.slug}/`}>
              <div>
                <h3>{o.title}</h3>
                <p>{o.summary}</p>
              </div>
              <span class="fitem__go">Read →</span>
            </a>
          ))}
        </div>
        <div class="cta-row">
          <a class="btn btn--primary" href="/install/">Download cowork-deck</a>
        </div>
      </aside>
    </article>
  </div>
</Base>
