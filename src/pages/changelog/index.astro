---
import Base from '../../layouts/Base.astro'
import { SITE } from '../../data/site'
import { breadcrumbs } from '../../data/schema'
import { firstParagraph } from '../../data/markdown'
import data from '../../data/releases.json'

const releases = data.releases
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<Base
  title="Changelog"
  description="Every cowork-deck release, what shipped in it and why — from the first version to the current one. Also available as an RSS feed."
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'cowork-deck changelog',
      url: `${SITE.url}/changelog/`,
      description: 'Release notes for every version of cowork-deck.',
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#app` },
    },
    breadcrumbs([
      { name: 'cowork-deck', path: '/' },
      { name: 'Changelog', path: '/changelog/' },
    ]),
  ]}
>
  <div class="wrap">
    <div class="phead">
      <p class="eyebrow">Changelog</p>
      <h1 class="h1--page">What has shipped</h1>
      <p class="lede">
        Every release, with the reasoning rather than a list of commit subjects.
        Also an <a href="/rss.xml">RSS feed</a>, if you would rather be told.
      </p>
    </div>

    {/* A dated list on hairlines, with the date in its own mono gutter. Seven
        release cards would say these are seven of the same size, and they are
        not — one of them was a single cherry-picked fix. */}
    <ol class="releases">
      {releases.map((r) => (
        <li class="release">
          <p class="release__when">
            <time datetime={r.publishedAt}>{fmt(r.publishedAt)}</time>
          </p>
          <div>
            <h2>
              <a href={`/changelog/${r.tag}/`}>{r.tag}</a>
              {r.prerelease && <span class="release__pre">pre-release</span>}
            </h2>
            <p>{firstParagraph(r.body)}</p>
            <p class="release__links">
              <a href={`/changelog/${r.tag}/`}>Release notes</a>
              <a href={r.url} rel="noopener">On GitHub</a>
              {r.downloads.length > 0 && <a href="/install/">Download</a>}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
