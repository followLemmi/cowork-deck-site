---
import Base from '../layouts/Base.astro'
import { FAQ, FAQ_GROUPS } from '../data/faq'
import { breadcrumbs, faqPage } from '../data/schema'

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<Base
  title="Frequently asked questions"
  description="Cost, requirements, platforms, privacy and how cowork-deck compares to tmux, terminal tabs and Claude Code's own subagents — answered in one page."
  schema={[
    faqPage(FAQ.map(({ q, a }) => ({ q, a }))),
    breadcrumbs([
      { name: 'cowork-deck', path: '/' },
      { name: 'FAQ', path: '/faq/' },
    ]),
  ]}
>
  <div class="wrap section">
    <p class="eyebrow">FAQ</p>
    <h1>Frequently asked questions</h1>
    <p class="lede" style="max-width: 54ch">
      Everything asked often enough to be worth writing down. If the answer you
      need is not here,
      <a href="https://github.com/followLemmi/cowork-deck/issues" rel="noopener"
        >an issue</a
      > is the right place to ask.
    </p>

    <nav class="toc" aria-label="On this page">
      <ul>
        {FAQ_GROUPS.map((g) => <li><a href={`#${slug(g)}`}>{g}</a></li>)}
      </ul>
    </nav>

    {
      FAQ_GROUPS.map((group) => (
        <section class="faq-group">
          <h2 id={slug(group)}>{group}</h2>
          {FAQ.filter((f) => f.group === group).map((item) => (
            <article class="qa">
              <h3 id={slug(item.q)}>{item.q}</h3>
              {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
            </article>
          ))}
        </section>
      ))
    }

    <p class="faq-cta">
      <a class="btn btn--primary" href="/install/">Download cowork-deck</a>
    </p>
  </div>
</Base>

<style>
  .toc {
    margin: 2.5rem 0 1rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-island);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--sh-island);
    max-width: var(--measure);
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }
  .toc li { margin: 0; }
  .toc a { font-size: 0.9375rem; color: var(--fg-mid); text-decoration: none; }
  .toc a:hover { color: var(--fg); text-decoration: underline; }

  .faq-group { margin-top: 3.5rem; }
  .faq-group h2 { font-size: 1.375rem; }
  .qa {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0;
    max-width: var(--measure);
  }
  .qa h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.5rem;
    scroll-margin-top: 5rem;
  }
  .qa p { color: var(--fg-mid); margin: 0; }
  .faq-cta { margin-top: 3.5rem; }
</style>
