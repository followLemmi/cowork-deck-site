---
import Base from '../layouts/Base.astro'
import { SITE } from '../data/site'
import { FAQ, FAQ_GROUPS } from '../data/faq'
import { breadcrumbs, faqPage } from '../data/schema'

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<Base
  title="Frequently asked questions"
  description="Cost, requirements, platforms, privacy and how cowork-deck compares to tmux, terminal tabs and Claude Code's own subagents — answered in one page."
  schema={[
    faqPage(FAQ.map(({ q, a }) => ({ q, a }))),
    breadcrumbs([
      { name: 'cowork-deck', path: '/' },
      { name: 'FAQ', path: '/faq/' },
    ]),
  ]}
>
  <div class="wrap">
    <div class="phead">
      <p class="eyebrow">FAQ</p>
      <h1 class="h1--page">Frequently asked questions</h1>
      <p class="lede">
        Everything asked often enough to be worth writing down. If the answer you
        need is not here,
        <a href={SITE.issues} rel="noopener">an issue</a> is the right place to
        ask.
      </p>
    </div>

    {/* A row of chips on the canvas rather than a boxed table of contents: an
        island here would be a raised surface competing with nothing. */}
    <nav aria-label="On this page">
      <ul class="toc">
        {FAQ_GROUPS.map((g) => <li><a href={`#${slug(g)}`}>{g}</a></li>)}
      </ul>
    </nav>

    {FAQ_GROUPS.map((group) => (
      <section class="qa-group">
        <h2 id={slug(group)}>{group}</h2>
        <div class="qa-list">
          {FAQ.filter((f) => f.group === group).map((item) => (
            <article class="qa">
              <h3 id={slug(item.q)}>{item.q}</h3>
              {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
            </article>
          ))}
        </div>
      </section>
    ))}

    <div class="more">
      <h2>Still reading</h2>
      <p class="lede" style="margin-bottom: 0">
        Nothing above needs an account, a key or a card.
      </p>
      <div class="cta-row">
        <a class="btn btn--primary" href="/install/">Download cowork-deck</a>
        <a class="btn btn--ghost" href={SITE.repo} rel="noopener">Read the source</a>
      </div>
    </div>
  </div>
</Base>
